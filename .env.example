# BrickLink API Credentials
# Get your keys at: https://www.bricklink.com/v2/api/register_consumer.page
#
# Usage: cp .env.example .env && nano .env && source .env

export BRICKLINK_CONSUMER_KEY=your_consumer_key_here
export BRICKLINK_CONSUMER_SECRET=your_consumer_secret_here
export BRICKLINK_TOKEN=your_token_here
export BRICKLINK_TOKEN_SECRET=your_token_secret_here
